{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kajisho5/oncemore/schema/build-request.schema.json",
  "title": "oncemore build request",
  "description": "What a disc is to hold, as another program (an editing agent) asks for it: titles, their chapters, the menu's texts and the subtitle tracks. oncemore makes the project from it (DECISIONS §142). Paths are relative to the request file.",
  "type": "object",
  "required": ["schema", "label", "titles"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "oncemore/build-request@1"},
    "format": {"enum": ["dvd", "bluray"], "default": "dvd", "description": "DVD-Video or Blu-ray."},
    "label": {"type": "string", "minLength": 1, "maxLength": 32, "description": "Disc label (A-Z 0-9 _ after normalisation)."},
    "standard": {"enum": ["NTSC", "PAL"], "default": "NTSC", "description": "DVD only."},
    "aspect": {"enum": ["4:3", "16:9"], "default": "16:9"},
    "menu": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": {"type": "string", "minLength": 1, "maxLength": 60, "description": "The menu's heading (default: the label)."},
        "texts": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 80},
                  "description": "Lines under the heading (date, venue, ...)."},
        "play_label": {"type": "string", "minLength": 1, "maxLength": 30, "description": "The play button (default PLAY, or PLAY ALL with several titles)."},
        "chapters_label": {"type": "string", "minLength": 1, "maxLength": 30, "description": "The button to a title's chapter menu (default CHAPTERS)."}
      }
    },
    "titles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "description": "The titles in play order; each gets a button on the menu.",
      "items": {
        "type": "object",
        "required": ["name", "source"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 60},
          "source": {"type": "string", "minLength": 1, "description": "The finished video, relative to the request file."},
          "chapters": {
            "type": "array",
            "maxItems": 99,
            "description": "Chapter starts with their names (a session per chapter); the first is at 0 when it is not given.",
            "items": {
              "type": "object",
              "required": ["time"],
              "additionalProperties": false,
              "properties": {
                "time": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "string", "pattern": "^[0-9]{1,2}:[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?$"}]},
                "name": {"type": "string", "minLength": 1, "maxLength": 60}
              }
            }
          },
          "subtitles": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": ["file"],
              "additionalProperties": false,
              "properties": {
                "file": {"type": "string", "minLength": 1, "description": ".srt, .vtt, .ass / .ssa or .txt, relative to the request file."},
                "lang": {"type": "string", "pattern": "^[a-z]{2}$"},
                "default": {"type": "boolean"}
              }
            }
          }
        }
      }
    }
  }
}
