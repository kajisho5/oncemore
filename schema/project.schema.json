{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kajisho5/oncemore/schema/project.schema.json",
  "title": "oncemore project",
  "description": "Input file for the oncemore DVD-Video authoring tool (project.oncemore.json).",
  "type": "object",
  "required": [
    "version",
    "disc",
    "titles"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1,
      "description": "Project format version."
    },
    "disc": {
      "$ref": "#/$defs/disc"
    },
    "titles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 99,
      "items": {
        "$ref": "#/$defs/title"
      }
    },
    "menus": {
      "type": "array",
      "maxItems": 99,
      "items": {
        "$ref": "#/$defs/menu"
      }
    },
    "playlists": {
      "type": "array",
      "maxItems": 99,
      "items": {
        "$ref": "#/$defs/playlist"
      },
      "description": "Sequences of titles and chapter ranges, started by playlist:<id> buttons."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,40}$",
      "description": "Identifier used in actions, e.g. title:t1 or menu:main."
    },
    "color": {
      "type": "string",
      "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
    },
    "time": {
      "description": "Seconds as a number, or \"HH:MM:SS[.mmm]\", \"MM:SS[.mmm]\", \"SS[.mmm]\".",
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^([0-9]+:){0,2}[0-9]+(\\.[0-9]+)?$"
        }
      ]
    },
    "bitrate": {
      "description": "Bits per second as an integer, or a string such as \"192k\" or \"5.5M\".",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?[kKmM]?$"
        }
      ]
    },
    "action": {
      "type": "string",
      "description": "menu:<id> | title:<id> | chapter:<title id>:<n> (1-based) | playall | playlist:<id> | audio:<n> | subtitle:<n> | subtitle:off | stop. playall plays every title in project order, then follows the last title's end_action.",
      "pattern": "^(menu:[A-Za-z0-9_-]{1,40}|title:[A-Za-z0-9_-]{1,40}|chapter:[A-Za-z0-9_-]{1,40}:[1-9][0-9]*|playall|playlist:[A-Za-z0-9_-]{1,40}|audio:[1-8]|subtitle:([1-9]|[12][0-9]|3[0-2]|off)|stop)$"
    },
    "disc": {
      "type": "object",
      "required": [
        "label",
        "standard",
        "aspect"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "ISO volume label. Normalised to A-Z 0-9 _ and at most 32 characters."
        },
        "standard": {
          "enum": [
            "NTSC",
            "PAL"
          ]
        },
        "aspect": {
          "enum": [
            "4:3",
            "16:9"
          ]
        },
        "target": {
          "enum": [
            "DVD5",
            "DVD9"
          ],
          "default": "DVD5"
        },
        "first_play": {
          "type": "string",
          "pattern": "^((menu|title):[A-Za-z0-9_-]{1,40}|playall|playlist:[A-Za-z0-9_-]{1,40})$",
          "description": "menu:<id> | title:<id> | playall | playlist:<id>. What starts when the disc is inserted. Default: first menu, or first title if there are no menus."
        },
        "title_key": {
          "type": "string",
          "pattern": "^((menu|title):[A-Za-z0-9_-]{1,40}|playall|playlist:[A-Za-z0-9_-]{1,40})$",
          "description": "What the remote's Title / Top Menu key opens: menu:<id> | title:<id> | playall | playlist:<id>. Default: the first menu."
        },
        "font": {
          "type": [
            "string",
            "null"
          ],
          "description": "Font file for menu text. null = auto-detect (Hiragino on macOS, then Noto Sans CJK, then DejaVu Sans)."
        },
        "video_bitrate": {
          "description": "\"auto\" (fit the disc, default) or a fixed average video bitrate.",
          "anyOf": [
            {
              "const": "auto"
            },
            {
              "$ref": "#/$defs/bitrate"
            }
          ]
        },
        "subtitle_style": {
          "type": "object",
          "additionalProperties": false,
          "description": "Look of burned subtitle bitmaps (all subtitle tracks).",
          "properties": {
            "size": {
              "type": "integer",
              "minimum": 12,
              "maximum": 80,
              "description": "Font size in pixels. Default 30 (NTSC) / 36 (PAL)."
            },
            "color": {
              "$ref": "#/$defs/color"
            },
            "outline": {
              "$ref": "#/$defs/color"
            },
            "outline_width": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "margin": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200,
              "description": "Distance of the last line from the bottom."
            }
          }
        },
        "rom_files": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string"
          },
          "description": "Files or folders copied to the root of the disc next to VIDEO_TS (DVD-ROM content for computers)."
        }
      }
    },
    "chapter_menu": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "Menu id. Default: chapters_<title id>. Extra pages get _2, _3, ..."
        },
        "title": {
          "type": "string",
          "description": "Heading text. Default: the title name."
        },
        "back": {
          "$ref": "#/$defs/action",
          "description": "Action of the BACK button. Default: the first menu."
        },
        "background": {
          "type": [
            "string",
            "null"
          ]
        },
        "background_color": {
          "$ref": "#/$defs/color"
        },
        "label_format": {
          "type": "string",
          "description": "Label under each thumbnail; {n} is the chapter number. Default: \"Chapter {n}\"."
        },
        "back_label": {
          "type": "string"
        },
        "prev_label": {
          "type": "string"
        },
        "next_label": {
          "type": "string"
        },
        "highlight_color": {
          "$ref": "#/$defs/color"
        },
        "select_color": {
          "$ref": "#/$defs/color"
        },
        "normal_color": {
          "$ref": "#/$defs/color"
        },
        "text_color": {
          "$ref": "#/$defs/color"
        },
        "audio": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration": {
          "type": "number",
          "minimum": 1,
          "maximum": 600
        },
        "background_video": {
          "type": "string",
          "description": "Motion background for the chapter menu."
        },
        "animated_thumbnails": {
          "type": "boolean",
          "default": false,
          "description": "With background_video: the thumbnails play the chapter instead of a still frame."
        }
      }
    },
    "title": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "description": "Human-readable name (used in chapter menus)."
        },
        "source": {
          "type": "string",
          "description": "Video file, relative to the project file."
        },
        "slideshow": {
          "$ref": "#/$defs/slideshow",
          "description": "Make this title from pictures instead of a video file."
        },
        "clips": {
          "type": "array",
          "minItems": 1,
          "maxItems": 99,
          "description": "Make this title from several videos played one after another (each optionally trimmed), instead of one source. Every clip starts a chapter unless chapters are given.",
          "items": {
            "type": "object",
            "required": ["source"],
            "additionalProperties": false,
            "properties": {
              "source": {"type": "string", "description": "Video file, relative to the project file."},
              "in": {"$ref": "#/$defs/time", "description": "Start inside the file (default: its beginning)."},
              "out": {"$ref": "#/$defs/time", "description": "End inside the file (default: its end)."}
            }
          }
        },
        "chapters": {
          "type": "array",
          "maxItems": 99,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/time"
              },
              {
                "type": "object",
                "required": [
                  "time"
                ],
                "additionalProperties": false,
                "properties": {
                  "time": {
                    "$ref": "#/$defs/time"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 60,
                    "description": "Shown on the chapter menu instead of \"Chapter n\"."
                  },
                  "poster": {
                    "$ref": "#/$defs/time",
                    "description": "Time (in the title) of the chapter menu thumbnail."
                  }
                }
              }
            ]
          },
          "description": "Chapter start times, or {time, name, poster} objects. 0 is added automatically if missing."
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "codec": {
              "enum": [
                "ac3",
                "lpcm"
              ],
              "default": "ac3"
            },
            "bitrate": {
              "$ref": "#/$defs/bitrate",
              "description": "AC-3 only. Default 192k (448k for 5.1)."
            },
            "channels": {
              "enum": [
                2,
                6
              ],
              "default": 2,
              "description": "2 = stereo (sources are down-mixed), 6 = 5.1 (AC-3 only)."
            },
            "lang": {
              "$ref": "#/$defs/lang"
            },
            "passthrough": {
              "type": "boolean",
              "default": false,
              "description": "Copy AC-3 audio (48 kHz, from the sources) onto the disc unchanged instead of re-encoding it."
            }
          }
        },
        "end_action": {
          "type": "string",
          "pattern": "^(menu:[A-Za-z0-9_-]{1,40}|title:[A-Za-z0-9_-]{1,40}|stop)$",
          "description": "menu:<id> | title:<id> | stop. Default: first menu, or stop."
        },
        "remote_menu": {
          "$ref": "#/$defs/id",
          "description": "Menu opened by the remote's Menu key during this title. Default: the first menu."
        },
        "auto_chapter_menu": {
          "description": "Generate a chapter-selection menu with thumbnails for this title.",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/chapter_menu"
            }
          ]
        },
        "audio_tracks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "description": "Audio streams of this title (replaces the single default track). codec/bitrate come from `audio`.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "description": "File to take the audio from. Default: the title source."
              },
              "stream": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31,
                "description": "Index among that file's audio streams. Default 0."
              },
              "lang": {
                "$ref": "#/$defs/lang"
              }
            }
          }
        },
        "subtitles": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "file"
            ],
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string",
                "description": "Subtitle file: SubRip (.srt), WebVTT (.vtt) or ASS / SSA (.ass, .ssa)."
              },
              "lang": {
                "$ref": "#/$defs/lang"
              },
              "default": {
                "type": "boolean",
                "description": "Show this track when the title starts."
              },
              "position": {
                "enum": [
                  "bottom",
                  "top"
                ],
                "default": "bottom",
                "description": "Where the lines go (cues can override with {\\an8} / line:0 / ASS alignment)."
              },
              "color": {
                "$ref": "#/$defs/color",
                "description": "Text colour of this track (default: disc.subtitle_style.color); cues can override it."
              }
            }
          }
        },
        "aspect": {
          "enum": [
            "4:3",
            "16:9"
          ],
          "description": "Display aspect of this title (default: disc.aspect). Titles with a different aspect or audio codec go into their own DVD titleset automatically."
        },
        "video_bitrate": {
          "$ref": "#/$defs/bitrate",
          "description": "This title's own average video bitrate (1-8 Mbit/s); the other titles share what is left on the disc."
        },
        "scan": {
          "enum": ["auto", "progressive", "interlaced", "pulldown"],
          "default": "auto",
          "description": "How the picture is stored. auto: interlaced sources at the disc's frame rate and 50p / 59.94p sources stay interlaced (every field kept), 23.976p film on NTSC gets soft 3:2 pulldown, everything else is progressive. progressive: deinterlace and convert the frame rate. interlaced / pulldown force that mode."
        }
      },
      "anyOf": [
        {
          "required": [
            "source"
          ]
        },
        {
          "required": [
            "slideshow"
          ]
        },
        {
          "required": [
            "clips"
          ]
        }
      ]
    },
    "text": {
      "type": "object",
      "required": [
        "text",
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 719
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 575
        },
        "size": {
          "type": "integer",
          "minimum": 8,
          "maximum": 200
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "font": {
          "type": "string",
          "description": "Font file for this element (default: the disc font). It must contain every character."
        },
        "outline": {
          "$ref": "#/$defs/color",
          "description": "Outline colour around the letters."
        },
        "outline_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 2
        },
        "shadow": {
          "$ref": "#/$defs/color",
          "description": "Drop shadow colour (#RRGGBBAA for a soft one)."
        },
        "shadow_offset": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 3
        }
      }
    },
    "nav": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "up": {
          "$ref": "#/$defs/id"
        },
        "down": {
          "$ref": "#/$defs/id"
        },
        "left": {
          "$ref": "#/$defs/id"
        },
        "right": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "button": {
      "type": "object",
      "required": [
        "id",
        "x",
        "y",
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Text of the button. Optional for image buttons (then only shown in the editor)."
        },
        "image": {
          "type": "string",
          "description": "Image button: a picture (PNG with transparency works best) drawn at x/y instead of the label."
        },
        "width": {
          "type": "integer",
          "minimum": 8,
          "maximum": 720,
          "description": "Image buttons: width in menu pixels (720-wide grid); the height follows the picture's aspect. Default: the picture's own width."
        },
        "highlight": {
          "enum": [
            "frame",
            "shape"
          ],
          "default": "frame",
          "description": "Image buttons: a frame around the picture, or its shape (opaque pixels) in the highlight colour."
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 719,
          "description": "Left edge of the label or image, in menu pixels (720 wide)."
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 575,
          "description": "Top edge of the label or image (480 high for NTSC, 576 for PAL)."
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "auto_activate": {
          "type": "boolean",
          "default": false,
          "description": "Run the action as soon as the button is selected (no Enter needed)."
        },
        "size": {
          "type": "integer",
          "minimum": 8,
          "maximum": 200
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "nav": {
          "$ref": "#/$defs/nav",
          "description": "Override automatic up/down/left/right navigation (button ids)."
        },
        "font": {
          "type": "string",
          "description": "Font file for this element (default: the disc font). It must contain every character."
        },
        "outline": {
          "$ref": "#/$defs/color",
          "description": "Outline colour around the letters."
        },
        "outline_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 2
        },
        "shadow": {
          "$ref": "#/$defs/color",
          "description": "Drop shadow colour (#RRGGBBAA for a soft one)."
        },
        "shadow_offset": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 3
        },
        "highlight_image": {
          "type": "string",
          "description": "A picture whose opaque pixels are this button's highlight, placed at x/y (sized like the image button, or at its own size scaled to the 720-wide grid with `width`). Without label and image the button is just this highlight over the background (e.g. imported from a layered Photoshop file)."
        },
        "thumbnail": {
          "type": "object",
          "required": ["x", "y", "w", "h"],
          "additionalProperties": false,
          "description": "A picture of the button's title / chapter (its action must be title:... or chapter:...), drawn into this rectangle of the menu.",
          "properties": {
            "x": {"type": "integer", "minimum": 0, "maximum": 719},
            "y": {"type": "integer", "minimum": 0, "maximum": 575},
            "w": {"type": "integer", "minimum": 8, "maximum": 720},
            "h": {"type": "integer", "minimum": 8, "maximum": 576},
            "time": {"$ref": "#/$defs/time", "description": "Frame to show (default: one second into the chapter)."},
            "animated": {"type": "boolean", "default": false, "description": "Play the chapter in a motion menu."}
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "label"
          ]
        },
        {
          "required": [
            "image"
          ]
        },
        {
          "required": [
            "highlight_image"
          ]
        }
      ]
    },
    "menu": {
      "type": "object",
      "required": [
        "id",
        "buttons"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "background": {
          "type": [
            "string",
            "null"
          ],
          "description": "Still image (PNG/JPEG...). Scaled to fit the disc aspect."
        },
        "psd": {
          "type": "string",
          "description": "The layered Photoshop file this menu was imported from (kept so it can be imported again after editing)."
        },
        "background_color": {
          "$ref": "#/$defs/color",
          "description": "Used when background is null, and for letterbox bars."
        },
        "audio": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional looping background music."
        },
        "duration": {
          "type": "number",
          "minimum": 1,
          "maximum": 600,
          "description": "Loop length in seconds. Default 5, or the music length."
        },
        "loop": {
          "description": "How many times the menu plays before its end_action: \"forever\" (default) or a count.",
          "anyOf": [
            {
              "const": "forever"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            }
          ]
        },
        "loop_point": {
          "$ref": "#/$defs/time",
          "description": "Where each repeat starts (motion menus / music): the part before it plays once, as an intro. Default 0."
        },
        "end_action": {
          "type": "string",
          "pattern": "^(menu:[A-Za-z0-9_-]{1,40}|title:[A-Za-z0-9_-]{1,40}|chapter:[A-Za-z0-9_-]{1,40}:[1-9][0-9]*|playall|playlist:[A-Za-z0-9_-]{1,40}|stop)$",
          "description": "What happens after the last loop (only with a loop count). Default: stop."
        },
        "default_button": {
          "$ref": "#/$defs/id",
          "description": "Button highlighted when the menu opens. Default: the first."
        },
        "remember_button": {
          "type": "boolean",
          "default": true,
          "description": "Coming back to this menu highlights the button used last (menus 1-7). Default true."
        },
        "font_size": {
          "type": "integer",
          "minimum": 8,
          "maximum": 200
        },
        "text_color": {
          "$ref": "#/$defs/color"
        },
        "highlight_color": {
          "$ref": "#/$defs/color"
        },
        "select_color": {
          "$ref": "#/$defs/color"
        },
        "normal_color": {
          "$ref": "#/$defs/color"
        },
        "texts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "shapes": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/shape"
          },
          "description": "Filled rectangles drawn under the texts and buttons (bars, panels)."
        },
        "buttons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 36,
          "items": {
            "$ref": "#/$defs/button"
          }
        },
        "background_video": {
          "type": [
            "string",
            "null"
          ],
          "description": "Video file for a motion menu (takes precedence over background). Its own audio is used when `audio` is not set."
        }
      }
    },
    "lang": {
      "type": "string",
      "pattern": "^[a-z]{2}$",
      "description": "ISO 639-1 language code, e.g. en, ja."
    },
    "playlist": {
      "type": "object",
      "required": [
        "id",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 99,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,40}(:[1-9][0-9]*(-[1-9][0-9]*)?)?$"
          },
          "description": "<title id> (whole title) | <title id>:<n> (one chapter) | <title id>:<first>-<last>."
        },
        "end_action": {
          "type": "string",
          "pattern": "^(menu:[A-Za-z0-9_-]{1,40}|title:[A-Za-z0-9_-]{1,40}|stop)$",
          "description": "After the last item. Default: stop."
        }
      }
    },
    "shape": {
      "type": "object",
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 719
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 575
        },
        "w": {
          "type": "integer",
          "minimum": 1,
          "maximum": 720
        },
        "h": {
          "type": "integer",
          "minimum": 1,
          "maximum": 576
        },
        "color": {
          "$ref": "#/$defs/color",
          "description": "Fill colour, #RRGGBBAA for translucent. Default #00000080."
        }
      }
    },
    "slideshow": {
      "type": "object",
      "required": [
        "slides"
      ],
      "additionalProperties": false,
      "properties": {
        "slides": {
          "type": "array",
          "minItems": 1,
          "maxItems": 99,
          "items": {
            "type": "object",
            "required": [
              "image"
            ],
            "additionalProperties": false,
            "properties": {
              "image": {
                "type": "string"
              },
              "duration": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 600,
                "default": 5
              }
            }
          }
        },
        "transition": {
          "enum": [
            "crossfade",
            "none"
          ],
          "default": "crossfade"
        },
        "transition_duration": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 5,
          "default": 1
        },
        "pan_zoom": {
          "type": "boolean",
          "default": false,
          "description": "A slow zoom in / out on every picture."
        },
        "audio": {
          "type": "string",
          "description": "Music, cut to the slideshow's length and faded out."
        },
        "background_color": {
          "$ref": "#/$defs/color",
          "description": "Around pictures of another shape. Default black."
        }
      }
    }
  }
}
